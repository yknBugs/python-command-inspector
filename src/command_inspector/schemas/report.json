{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command Inspector report 1.0.0",
  "oneOf": [
    {"type": "object", "maxProperties": 0},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analyzer_version", "rule_catalog_version", "level", "num_findings", "findings"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "analyzer_version": {"type": "string"},
        "rule_catalog_version": {"type": "string"},
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "BLOCK"]},
        "num_findings": {"type": "integer", "minimum": 1},
        "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}}
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "level", "type", "title", "detail", "data", "evidence"],
      "properties": {
        "rule": {"type": "string"},
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "BLOCK"]},
        "type": {"type": "string"},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "data": {"type": "object"},
        "evidence": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
